# ---- Django ----
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database (Neon / local PostgreSQL) ----
# Neon example: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/portfolio_db

# ---- CORS / Frontend ----
# React dev server origin(s), comma separated
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Base URL used to build links in verification / reset emails
FRONTEND_URL=http://localhost:5173

# ---- Email ----
# Dev default prints emails in the terminal. For real SMTP set:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.com

# ---- Production only ----
# CSRF_TRUSTED_ORIGINS=https://your-domain.com

SECRET_KEY=generate-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://user:password@localhost:5432/portfolio_db

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret



